(() => {
    ModAPI.meta.title("Netherite");
    ModAPI.meta.version("v2.1");
    ModAPI.meta.description("Netherite items for EaglerForge.");
    ModAPI.meta.credits("Custom EaglerForge mod");

    ModAPI.require("player");

    // =========================================================
    // CLASSES
    // =========================================================

    const tabs =
        ModAPI.reflect.getClassById(
            "net.minecraft.creativetab.CreativeTabs"
        );

    const itemClass =
        ModAPI.reflect.getClassById(
            "net.minecraft.item.Item"
        );

    const itemSuper =
        ModAPI.reflect.getSuper(
            itemClass,
            (x) => x.length === 1
        );

    // =========================================================
    // NETHERITE INGOT
    // =========================================================

    const NetheriteIngot = function () {
        itemSuper(this);

        this.$setCreativeTab(
            tabs.staticVariables.tabMisc
        );
    };

    ModAPI.reflect.prototypeStack(
        itemClass,
        NetheriteIngot
    );

    function registerNetheriteIngot() {

        if (ModAPI.items["netherite_ingot"]) {
            return ModAPI.items["netherite_ingot"];
        }

        const item =
            new NetheriteIngot()
                .$setUnlocalizedName(
                    ModAPI.util.str("netherite_ingot")
                )
                .$setMaxStackSize(64);

        itemClass.staticMethods.registerItem.method(
            ModAPI.keygen.item("netherite_ingot"),
            ModAPI.util.str("netherite_ingot"),
            item
        );

        ModAPI.items["netherite_ingot"] = item;

        console.log(
            "Netherite: Ingot registered."
        );

        return item;
    }

    // =========================================================
    // NETHERITE SWORD
    // =========================================================

    const NetheriteSword = function () {
        itemSuper(this);

        this.$setCreativeTab(
            tabs.staticVariables.tabCombat
        );
    };

    ModAPI.reflect.prototypeStack(
        itemClass,
        NetheriteSword
    );

    function registerNetheriteSword() {

        if (ModAPI.items["netherite_sword"]) {
            return ModAPI.items["netherite_sword"];
        }

        const item =
            new NetheriteSword()
                .$setUnlocalizedName(
                    ModAPI.util.str("netherite_sword")
                )
                .$setMaxStackSize(1)
                .$setMaxDamage(2031);

        itemClass.staticMethods.registerItem.method(
            ModAPI.keygen.item("netherite_sword"),
            ModAPI.util.str("netherite_sword"),
            item
        );

        ModAPI.items["netherite_sword"] = item;

        console.log(
            "Netherite: Sword registered."
        );

        return item;
    }

    // =========================================================
    // REGISTER ITEMS
    // =========================================================

    let netheriteIngot;
    let netheriteSword;

    function registerItems() {

        netheriteIngot =
            registerNetheriteIngot();

        netheriteSword =
            registerNetheriteSword();

        console.log(
            "Netherite: All items registered."
        );
    }

    if (ModAPI.items) {
        registerItems();
    } else {
        ModAPI.addEventListener(
            "bootstrap",
            registerItems
        );
    }

    // =========================================================
    // TEXTURES
    // =========================================================

    // Your uploaded 16x16 Netherite Ingot PNG
    const ingotTexture =
        "data:image/png;base64," +
        "";

    // 16x16 Netherite Sword PNG
    const swordTexture =
        "data:image/png;base64," +
        "iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAaElEQVR4nGNgoCa4dOnS/0uXLv0PCAj9T7JmDWW1/6OGDJAhTPgMuHH3FqOGstp/PT09RpJtR3eJkbLc/5SUTNJcAAM2js4MRo7eDOf2b2XAZgjRwEhZ7r+Rshz5BlDNEGU5Cg2gKgAAXZJdanZxWg8AAAAASUVORK5CYII=";

    // =========================================================
    // ASYNCSINK
    // =========================================================

    ModAPI.addEventListener(
        "lib:asyncsink",
        async () => {

            console.log(
                "Netherite: AsyncSink loaded."
            );

            // =================================================
            // ITEM RENDERING
            // =================================================

            ModAPI.addEventListener(
                "lib:asyncsink:registeritems",
                (renderItem) => {

                    if (netheriteIngot) {

                        renderItem.registerItem(
                            netheriteIngot,
                            ModAPI.util.str(
                                "netherite_ingot"
                            )
                        );

                    }

                    if (netheriteSword) {

                        renderItem.registerItem(
                            netheriteSword,
                            ModAPI.util.str(
                                "netherite_sword"
                            )
                        );

                    }

                    console.log(
                        "Netherite: Item models registered."
                    );
                }
            );

            // =================================================
            // NAMES
            // =================================================

            AsyncSink.L10N.set(
                "item.netherite_ingot.name",
                "Netherite Ingot"
            );

            AsyncSink.L10N.set(
                "item.netherite_sword.name",
                "Netherite Sword"
            );

            // =================================================
            // INGOT MODEL
            // =================================================

            AsyncSink.setFile(
                "resourcepacks/AsyncSinkLib/assets/minecraft/models/item/netherite_ingot.json",

                JSON.stringify({
                    "parent": "builtin/generated",

                    "textures": {
                        "layer0":
                            "items/netherite_ingot"
                    }
                })
            );

            // =================================================
            // SWORD MODEL
            // =================================================

            AsyncSink.setFile(
                "resourcepacks/AsyncSinkLib/assets/minecraft/models/item/netherite_sword.json",

                JSON.stringify({
                    "parent": "builtin/handheld",

                    "textures": {
                        "layer0":
                            "items/netherite_sword"
                    }
                })
            );

            // =================================================
            // INGOT TEXTURE
            // =================================================

            try {

                const ingotResponse =
                    await fetch(ingotTexture);

                const ingotPNG =
                    await ingotResponse.arrayBuffer();

                AsyncSink.setFile(
                    "resourcepacks/AsyncSinkLib/assets/minecraft/textures/items/netherite_ingot.png",
                    ingotPNG
                );

                console.log(
                    "Netherite: Ingot texture registered."
                );

            } catch (error) {

                console.error(
                    "Netherite: Failed to load ingot texture.",
                    error
                );

            }

            // =================================================
            // SWORD TEXTURE
            // =================================================

            try {

                const swordResponse =
                    await fetch(swordTexture);

                const swordPNG =
                    await swordResponse.arrayBuffer();

                AsyncSink.setFile(
                    "resourcepacks/AsyncSinkLib/assets/minecraft/textures/items/netherite_sword.png",
                    swordPNG
                );

                console.log(
                    "Netherite: Sword texture registered."
                );

            } catch (error) {

                console.error(
                    "Netherite: Failed to load sword texture.",
                    error
                );

            }

            console.log(
                "Netherite: Resources loaded successfully."
            );
        }
    );

})();
