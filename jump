        ModAPI.player.motionY = 1.5; 
        
        // ამატებს ეფექტს ჩატში
        ModAPI.displayToChat({ msg: "§b🚀 იაააჰუუუ! სუპერ ნახტომი აქტიურია!" });
    }
});
